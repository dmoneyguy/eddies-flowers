# ============================================================
# Eddie's Flowers — environment variables
# Copy to .env.local for dev. In Vercel, set these in the
# project's Environment Variables tab (Production + Preview).
# ============================================================

# Neon Postgres write role with INSERT on control_plane.eddies_flowers_leads
DATABASE_URL_WRITE=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Resend API key for transactional email (waitlist acknowledgment + internal alerts)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives "new waitlist signup" notifications.
# Default: eddies-leads@thelegacyops.com  (verify mailbox exists or create it)
NOTIFICATION_EMAIL=eddies-leads@thelegacyops.com

# Public-facing site values (NEXT_PUBLIC_* are inlined into the browser bundle)
NEXT_PUBLIC_LICENSE_NUMBER=MRN284579
NEXT_PUBLIC_SITE_URL=https://eddiesflower.com

# Email sender identity for Resend "from" address. Recommend using a
# verified sender on the eddiesflower.com domain (DKIM/SPF/DMARC needs
# to be configured in Resend + Google Cloud DNS before this works).
RESEND_FROM_EMAIL=Eddie's Flowers <hello@eddiesflower.com>
